+                        }
+                    }
+                }
+            }
+        },
+        confirmButton = {
+            Button(
+                onClick = onDismiss,
+                colors = ButtonDefaults.buttonColors(containerColor = MetGhamrNavy)
+            ) {
+                Text("إغلاق")
+            }
+        }
+    )
+}
