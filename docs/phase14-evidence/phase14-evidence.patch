+                            }
+                        }
+
+                        // Map Legend Watermark Badge (Top Left)
+                        Surface(
+                            shape = RoundedCornerShape(10.dp),
+                            color = MetGhamrNavy.copy(alpha = 0.90f),
+                            modifier = Modifier
+                                .align(Alignment.TopStart)
+                                .padding(14.dp)
