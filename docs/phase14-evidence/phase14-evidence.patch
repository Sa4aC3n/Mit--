+            .replace("ى", "ي")
+            .replace("ة", "ه")
+            .replace("ؤ", "و")
+            .replace("ئ", "ي")
+            .replace("[\\u064B-\\u065F]".toRegex(), "") // Remove Harakat / Tashkeel
