+    val star5Count: Int,
+    val star4Count: Int,
+    val star3Count: Int,
+    val star2Count: Int,
+    val star1Count: Int
+) {
+    fun getStarPercentage(star: Int): Float {
+        if (totalCount <= 0) return 0f
+        val count = when (star) {
+            5 -> star5Count
+            4 -> star4Count
+            3 -> star3Count
+            2 -> star2Count
+            1 -> star1Count
+            else -> 0
+        }
+        return count.toFloat() / totalCount.toFloat()
+    }
+}
