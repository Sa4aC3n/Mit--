+@Composable
+fun NationalEmergencyCardItem(
+    contact: EmergencyContact,
+    onCallClick: () -> Unit,
+    onCopyClick: () -> Unit
+) {
+    Card(
+        shape = RoundedCornerShape(16.dp),
