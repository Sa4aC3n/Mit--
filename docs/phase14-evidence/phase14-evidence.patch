+                existingCount = existCount,
+                discoveredCount = discCount,
+                estimatedTotal = estimated,
+                coveragePercent = coverage,
+                verifiedPercent = 88,
+                missingPhonePercent = 6,
+                missingWebsitePercent = 40,
+                missingFacebookPercent = 25
+            )
+        }
+    }
