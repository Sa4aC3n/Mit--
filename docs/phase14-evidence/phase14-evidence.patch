+                                Spacer(modifier = Modifier.width(8.dp))
+                                Text(
+                                    "Smart Directory Data Collector",
+                                    color = Color.White,
+                                    fontSize = 18.sp,
+                                    fontWeight = FontWeight.Bold
+                                )
+                            }
+                            Text(
