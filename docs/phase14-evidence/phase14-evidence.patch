+                                fontSize = 13.sp,
+                                color = TextPrimary
+                            )
+                            Spacer(modifier = Modifier.width(6.dp))
+                            val provider = try { AuthProvider.valueOf(review.userProvider) } catch (e: Exception) { AuthProvider.GOOGLE }
+                            ProviderBadge(provider = provider)
