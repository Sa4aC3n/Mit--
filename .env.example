# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_WEB_CLIENT_ID: Required for Firebase Google Sign-In via Credential Manager
GOOGLE_WEB_CLIENT_ID=your_web_client_id_here

# OWNER_EMAIL: The admin owner email address used for local app security gate.
# SECURITY: This is injected via BuildConfig from .env — NOT hardcoded in source.
# Set this in your local .env file (which is gitignored).
OWNER_EMAIL=your_admin_email@example.com

# MASTER_PIN_HASH: Optional SHA-256 hash of the master PIN for local security gate.
# If not set, the PIN must be configured at first run via Admin Settings.
# Generate with: echo -n "YOUR_PIN_PLUS_SALT" | sha256sum
# MASTER_PIN_HASH=

