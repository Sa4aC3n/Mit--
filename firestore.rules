rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'm.k3shka@gmail.com'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Published Businesses Collection (Authoritative Central Source of Truth)
    match /businesses/{businessId} {
      // Public directory read is strictly permitted for published businesses
      // Unauthenticated or regular users CANNOT read unpublished or drafted items
      allow read: if isAdmin() || (resource.data.isPublished == true);

      // Normal users CANNOT create, update, or delete published businesses under any circumstances.
      // Only trusted server/Admin can perform writes, updates, and tombstones.
      allow write: if isAdmin();
    }

    // 2. Legacy Activities Collection (Protected during migration, no unauthorized writes)
    match /activities/{activityId} {
      allow read: if isAdmin() || (resource.data.isPublished == true);
      allow write: if isAdmin();
    }

    // 3. User Contributions & Moderation Queue
    match /contributions/{contribId} {
      // Normal users can only read their own submitted contributions
      // Admins can read all contributions for moderation
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Normal users can ONLY create new requests with status 'PENDING' for their own account
      // They are strictly forbidden from setting approvedAt, approvedBy, or publishedBusinessId
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == null) &&
        (!('approvedBy' in request.resource.data) || request.resource.data.approvedBy == null) &&
        (!('publishedBusinessId' in request.resource.data) || request.resource.data.publishedBusinessId == null);

      // Normal users CANNOT update status, approve, or delete approved requests. Only Admin can update/delete.
      allow update, delete: if isAdmin();
    }

    // 4. Official Taxonomies & Categories (26 main categories, 103 subcategories)
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Multi-Source Provenance & Business Sources
    match /businessSources/{sourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Reviews & Ratings Collection
    match /reviews/{reviewId} {
      // Only approved reviews are visible to the public; Admin can view all
      allow read: if isAdmin() || (resource.data.status == 'APPROVED');

      // Authenticated users can write their own reviews with 1-5 rating validation
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0;

      // Users can update their own comment/rating, Super Admin can moderate
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5
      );

      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // 7. Audit Logs & System Governance
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 8. System Configurations & App Metadata
    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
