rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && ('admin' in request.auth.token) && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Published Businesses Collection (Authoritative Single Source of Truth)
    match /businesses/{businessId} {
      // Public directory read is strictly permitted for published businesses
      // Client query MUST include .whereEqualTo("isPublished", true)
      allow read: if (resource != null && resource.data.isPublished == true) || isAdmin();

      // Authorized Server/Admin write permission:
      // Admins (verified via custom claim admin == true) can manage businesses directly or via Cloud Functions.
      allow write: if isAdmin();
    }

    // 2. Legacy Activities Collection (Protected, read-only for published)
    match /activities/{activityId} {
      allow read: if (resource != null && resource.data.isPublished == true) || isAdmin();
      allow write: if isAdmin();
    }

    // 3. User Contributions & Moderation Queue
    match /contributions/{contribId} {
      // Normal users can only read their own submitted contributions
      // Admins can read all contributions for moderation
      allow read: if isAdmin() || (isAuthenticated() && resource != null && resource.data.userId == request.auth.uid);

      // Normal users can ONLY create new requests with status 'PENDING' for their own account
      // They are strictly forbidden from setting approvedAt, approvedBy, or publishedBusinessId
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == null) &&
        (!('approvedBy' in request.resource.data) || request.resource.data.approvedBy == null) &&
        (!('publishedBusinessId' in request.resource.data) || request.resource.data.publishedBusinessId == null);

      // Users can cancel/delete their own pending request before review
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid && resource.data.status == 'PENDING';

      // Direct client updates (moderation, status changes) are forbidden.
      // All moderation updates MUST go through Cloud Functions (approveContribution / rejectContribution).
      allow update: if false;
    }

    // 4. Official Taxonomies & Categories (Read-only for clients)
    match /categories/{catId} {
      allow read: if true;
      allow write: if false;
    }

    // 5. Multi-Source Provenance & Business Sources
    // Public directory metadata is accessible to all clients
    // Private user request payloads are strictly quarantined in privatePayload subcollection (Admin only)
    match /businessSources/{sourceId} {
      allow read: if true;
      allow write: if isAdmin();

      match /privatePayload/{docId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    // 6. Reviews & Ratings Collection
    match /reviews/{reviewId} {
      // Only approved reviews are visible to the public; author or admin can view draft/own
      allow read: if (resource != null && resource.data.status == 'APPROVED') || (isAuthenticated() && resource != null && resource.data.userId == request.auth.uid) || isAdmin();

      // Authenticated users can write their own reviews with 1-5 rating validation
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0;

      // Users can update their own comment/rating without elevating or changing review status
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;

      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 7. Audit Logs & System Governance (Admin read only, written via Cloud Functions)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 8. System Configurations & App Metadata (Public read, admin write via Admin SDK)
    match /system_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 9. Business Tombstones & Deletion / Unpublish Change Feed
    match /business_tombstones/{tombstoneId} {
      // Public directory clients can read tombstones to evict unpublished/deleted records from local Room cache
      allow read: if true;
      // Admins and Cloud Functions can create/manage deletion tombstones
      allow write: if isAdmin();
    }
  }
}
